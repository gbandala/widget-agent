# OpenRouter
OPENROUTER_API_KEY=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cifrado PII (AES-256, obligatorio en prod)
# Generar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PII_ENCRYPTION_KEY=

# Admin panel — mismo método de generación que PII_ENCRYPTION_KEY
ADMIN_SECRET_KEY=

# Upstash Redis — rate limiting distribuido
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# URL pública del deploy
NEXT_PUBLIC_APP_URL=https://tu-dominio.com

# Token para la demo page en / (generar con: pnpm setup)
NEXT_PUBLIC_DEMO_WIDGET_TOKEN=

# Google Calendar OAuth (opcional — solo para agendamiento)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://tu-dominio.com/api/auth/google/callback
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# Rate limits (opcional — defaults: 20 rpm por IP, 200 rph por token)
WIDGET_RATE_LIMIT_RPM=20
WIDGET_TOKEN_RATE_LIMIT_RPH=200

# Audio
WHISPER_MODEL=openai/whisper-1
TTS_ENABLED=false
