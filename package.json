{
  "name": "widget-agent",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@playwright/test",
      "esbuild",
      "lightningcss",
      "sharp"
    ],
    "overrides": {
      "tmp": ">=0.2.6",
      "esbuild": ">=0.28.1"
    }
  },
  "scripts": {
    "dev": "next dev",
    "build": "tsx scripts/build-widget.ts && next build",
    "build:widget": "tsx scripts/build-widget.ts",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next build",
    "setup": "tsx scripts/setup.ts",
    "perf": "tsx scripts/perf-bench.ts",
    "test:unit": "tsx --test tests/unit/guards.test.ts",
    "test:api": "tsx --test tests/api/widget-scenarios.test.ts",
    "test": "tsx --test tests/unit/guards.test.ts && tsx --test tests/api/widget-scenarios.test.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "3.0.53",
    "@ai-sdk/openai-compatible": "2.0.41",
    "@ai-sdk/react": "3.0.166",
    "@upstash/ratelimit": "2.0.8",
    "@upstash/redis": "1.37.0",
    "ai": "6.0.164",
    "cfb": "1.2.2",
    "cheerio": "1.2.0",
    "exceljs": "4.4.0",
    "googleapis": "171.4.0",
    "lucide-react": "1.8.0",
    "mammoth": "1.12.0",
    "next": "16.2.6",
    "officeparser": "6.1.0",
    "pdf-parse": "2.4.5",
    "postgres": "^3.4.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "resend": "6.12.4",
    "tsx": "4.21.0",
    "zod": "4.3.6",
    "zustand": "5.0.12"
  },
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "@tailwindcss/postcss": "4.2.2",
    "@types/node": "20.19.39",
    "@types/pdf-parse": "1.1.5",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "esbuild": "0.28.1",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "playwright": "1.59.1",
    "tailwindcss": "4.2.2",
    "typescript": "5.9.3"
  }
}
